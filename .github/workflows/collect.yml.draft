# DRAFT (phase A). Rename to collect.yml in phase B once props, nflverse and the daily cache are final.
# Needs repository secrets INGEST_URL (site origin) and INGEST_KEY. Neither is printed by the collector.
name: collect

on:
  schedule:
    - cron: '*/5 * * * *'   # GitHub runs this "about" every 5 minutes; delays of several minutes are normal
  workflow_dispatch:

concurrency:
  group: collect
  cancel-in-progress: false  # never cancel a run that may be mid-POST; the next one waits

permissions:
  contents: read

jobs:
  collect:
    runs-on: ubuntu-latest
    timeout-minutes: 6
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Cache key for daily data
        id: day
        run: echo "date=$(date -u +%F)" >> "$GITHUB_OUTPUT"

      # Daily data (Kalshi fee info now; nflverse, rosters and depth charts in phase B) is fetched once per UTC day.
      - uses: actions/cache@v4
        with:
          path: .cache
          key: daily-${{ steps.day.outputs.date }}

      - name: Offline tests
        run: node --test test/*.test.mjs

      - name: Collect, post, settle
        run: node collect.mjs --post --settle --cache-dir .cache
        env:
          INGEST_URL: ${{ secrets.INGEST_URL }}
          INGEST_KEY: ${{ secrets.INGEST_KEY }}
